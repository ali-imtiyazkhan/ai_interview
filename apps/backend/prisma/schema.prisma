generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum InterviewStatus {
  Pre
  InProgress
  Done
}

enum InterviewMode {
  GENERAL
  DSA
}

enum EmbeddingSourceType {
  GITHUB_REPO
  GITHUB_README
  GITHUB_CODE
  GITHUB_LANGUAGES
  RESUME
  RESUME_REPO
}

enum QuestionCategory {
  TECHNICAL
  BEHAVIORAL
  PROJECT_DEEP_DIVE
  SKILL_ASSESSMENT
  SYSTEM_DESIGN
  CODING
  DSA
}

model Interview {
  id               String           @id @default(uuid())
  mode             InterviewMode    @default(GENERAL)
  candidateName    String?
  jobRole          String?
  experienceLevel  String?
  languages        String[]         @default([])
  topics           String[]         @default([])
  difficulty       String?
  githubMetaData   Json?
  status           InterviewStatus
  score            Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  embeddings Embedding[]
  questions  Question[]
  answers    Answer[]
}

model Embedding {
  id          String                @id @default(uuid())
  interviewId String
  interview   Interview             @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sourceType  EmbeddingSourceType
  chunkText   String
  embedding   Unsupported("vector(1536)")
  metadata    Json?
  createdAt   DateTime              @default(now())

  @@index([interviewId])
  @@index([sourceType])
}

model Question {
  id          String           @id @default(uuid())
  interviewId String
  interview   Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  category    QuestionCategory
  question    String
  order       Int
  createdAt   DateTime         @default(now())

  answers Answer[]

  @@index([interviewId])
  @@index([interviewId, order])
  @@unique([interviewId, order])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  interviewId String
  interview  Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  transcript String?
  audioUrl   String?
  score      Int?
  feedback   String?
  createdAt  DateTime @default(now())

  @@index([questionId])
  @@index([interviewId])
}
