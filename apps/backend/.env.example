# PostgreSQL connection string (with pgvector extension)
# For local Docker: postgres://interview:interview@localhost:5432/interview_promo
DATABASE_URL="postgres://interview:interview@localhost:5432/interview_promo"

# Backend server port
PORT=3001

# GitHub personal access token (optional — raises API rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=""

# Google Gemini API key (required for embeddings + LLM)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Gemini model for question generation and answer evaluation
GEMINI_LLM_MODEL="gemini-flash-latest"

# Gemini model for embeddings (must be an embedding model)
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# GitHub embedding limits (tune for free-tier API quotas)
# All repos get a lightweight summary; only top N repos get README deep-embed
GITHUB_MAX_DEEP_REPOS=8
GITHUB_MAX_README_CHARS=3000
GITHUB_MAX_README_CHUNKS=2
GITHUB_SUMMARY_CHUNK_SIZE=8000
